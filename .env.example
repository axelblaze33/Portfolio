# Copy this file to .env.local for local development:  cp .env.example .env.local
# In production, set the same variables in Vercel → Project → Settings → Environment Variables.
# Never commit real values.

# ── Site ────────────────────────────────────────────────────────────────
# Your final public URL (no trailing slash). Used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ── Contact form email delivery (Resend) ────────────────────────────────
# API key from https://resend.com/api-keys  (server-only; never exposed to the browser)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Inbox that receives contact form messages.
# While using Resend's test sender this MUST be the email address of your Resend account.
CONTACT_EMAIL=you@example.com

# Sender shown on the email. Must use a domain you have verified in Resend,
# or Resend's testing sender while you set things up:
#   FROM_EMAIL="Portfolio Contact <onboarding@resend.dev>"
FROM_EMAIL="Portfolio Contact <contact@your-domain.com>"

# ── Development only ────────────────────────────────────────────────────
# true = validate and log submissions on the server without sending email.
# Ignored in production builds.
CONTACT_DRY_RUN=false
